    <clipPath id="clip-sclera-right">
      <path d="M 538.03 502.5 C 538.03 506.59, 540.59 508.41, 542.51 511.59 C 544.42 514.77, 544.68 516.36, 547.62 518.41 C 550.56 520.45, 553.37 520.91, 557.21 521.82 C 561.04 522.73, 562.96 522.73, 566.8 522.95 C 570.63 523.18, 572.55 523.64, 576.38 522.95 C 580.22 522.27, 583.03 521.59, 585.97 519.55 C 588.91 517.5, 589.17 516.14, 591.09 512.73 C 593 509.32, 595.56 506.59, 595.56 502.5 C 595.56 498.41, 593 495.68, 591.09 492.27 C 589.17 488.86, 588.91 487.73, 585.97 485.45 C 583.03 483.18, 580.22 482.5, 576.38 480.91 C 572.55 479.32, 570.63 477.95, 566.8 477.5 C 562.96 477.05, 561.04 477.73, 557.21 478.64 C 553.37 479.55, 550.56 479.55, 547.62 482.05 C 544.68 484.55, 544.42 487.05, 542.51 491.14 C 540.59 495.23, 538.03 498.41, 538.03 502.5 Z" />
