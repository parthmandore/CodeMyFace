exports[`Baseline Regression Suite: Preserving Output Parity > renders deterministic, valid vector portraits for all baseline fixtures 5`] = `
"<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 1000" width="100%" height="100%">
  <title>CodeMyFace Vector Portrait</title>
  <desc>Original stylized geometric vector portrait generated client-side by CodeMyFace</desc>
  <defs>
    <linearGradient id="skin-volume-grad" x1="20%" y1="0%" x2="80%" y2="100%">
      <stop offset="0%" stop-color="#fff2e6" />
      <stop offset="55%" stop-color="#f8e2d2" />
      <stop offset="100%" stop-color="#e1c8b4" />
    </linearGradient>
