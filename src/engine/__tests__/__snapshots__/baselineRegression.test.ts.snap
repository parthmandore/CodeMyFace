      <stop offset="50%" stop-color="#2a1e18" stop-opacity="0.98" />
      <stop offset="100%" stop-color="#19120f" stop-opacity="1" />
    </linearGradient>
    <radialGradient id="iris-grad-left" cx="45%" cy="45%" r="52%">
      <stop offset="0%" stop-color="#5f534b" />
      <stop offset="60%" stop-color="#3c2d23" />
      <stop offset="92%" stop-color="#1e1612" />
      <stop offset="100%" stop-color="#150f0d" />
    </radialGradient>
    <radialGradient id="iris-grad-right" cx="45%" cy="45%" r="52%">
      <stop offset="0%" stop-color="#5f534b" />
      <stop offset="60%" stop-color="#3c2d23" />
      <stop offset="92%" stop-color="#1e1612" />
      <stop offset="100%" stop-color="#150f0d" />
