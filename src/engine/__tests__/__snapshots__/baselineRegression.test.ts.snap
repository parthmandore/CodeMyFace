exports[`Baseline Regression Suite: Preserving Output Parity > renders deterministic, valid vector portraits for all baseline fixtures 3`] = `
"<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 1000" width="100%" height="100%">
  <title>CodeMyFace Vector Portrait</title>
  <desc>Original stylized geometric vector portrait generated client-side by CodeMyFace</desc>
  <defs>
    <linearGradient id="skin-volume-grad" x1="80%" y1="0%" x2="20%" y2="100%">
      <stop offset="0%" stop-color="#ffebd7" />
      <stop offset="55%" stop-color="#f0d7c3" />
      <stop offset="100%" stop-color="#d2b9a5" />
    </linearGradient>
    <linearGradient id="hair-base-grad" x1="50%" y1="0%" x2="50%" y2="100%">
      <stop offset="0%" stop-color="#2e2d30" />
      <stop offset="45%" stop-color="#121014" />
      <stop offset="100%" stop-color="#0e0c0f" />
    </linearGradient>
    <linearGradient id="hair-lock-grad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#2a262e" stop-opacity="0.85" />
      <stop offset="100%" stop-color="#121014" stop-opacity="0.30" />
    </linearGradient>
    <linearGradient id="beard-body-grad" x1="50%" y1="0%" x2="50%" y2="100%">
      <stop offset="0%" stop-color="#252327" stop-opacity="0.95" />
      <stop offset="50%" stop-color="#121014" stop-opacity="0.98" />
      <stop offset="100%" stop-color="#0c0a0e" stop-opacity="1" />
    </linearGradient>
    <radialGradient id="iris-grad-left" cx="45%" cy="45%" r="52%">
