    <linearGradient id="hair-lock-grad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#4b372a" stop-opacity="0.85" />
      <stop offset="100%" stop-color="#2a1e18" stop-opacity="0.30" />
    </linearGradient>
    <linearGradient id="beard-body-grad" x1="50%" y1="0%" x2="50%" y2="100%">
