exports[`Baseline Regression Suite: Preserving Output Parity > renders deterministic, valid vector portraits for all baseline fixtures 2`] = `
"<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 1000" width="100%" height="100%">
